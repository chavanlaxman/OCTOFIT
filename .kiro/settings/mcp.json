{
  "mcpServers": {
    "atlassian": {
      "url": "http://localhost:3002/mcp",
      "type": "httpStream",
      "transportType": "httpStream",
      "disabled": false,
      "autoApprove": [
        "jira_get_issue",
        "jira_search",
        "jira_get_transitions",
        "jira_get_all_projects",
        "jira_get_agile_boards",
        "confluence_search",
        "confluence_get_page"
      ]
    },
    "gitlab": {
      "command": "npx.cmd",
      "args": [
        "-y",
        "@zereight/mcp-gitlab",
        "--api-url=https://git.epam.com/api/v4"
      ],
      "disabled": false
    }
  }
}